  "scripts": {
    "start": "vite",
    "dev": "pnpm run --parallel \"/^dev:.+/\"",
    "dev:vite": "pnpm start",
    "dev:partykit": "pnpm partykit:dev",
    "start:e2e": "E2E_FAKE_SFU_URL=http://127.0.0.1:3480/v1 vite --port 3020 --strictPort",
    "start:mock": "VITE_APP_OFFLINE=true vite",
    "start:https": "HTTPS=true vite",
    "start:production": "vite preview --port 3010",
    "prod:serve": "pnpm start:production",
    "serve:prod": "pnpm start:production",
    "build": "VITE_APP_PRERENDER=true vite build",
    "build:serve:e2e": "pnpm build && pnpm start:production",
    "build:serve:e2e:fast": "FAST_BUILD=1 pnpm build && pnpm start:production",
    "build:serve:e2e:watch": "FAST_BUILD=1 pnpm build --watch & pnpm start:production",
    "test": "vitest --project '!browser'",
    "test:staged": "vitest --project '!browser' --watch=false --changed --passWithNoTests",
    "test:browser": "vitest --project browser",
    "lint": "oxlint .",
    "generate-index": "pnpm tsx scripts/generate-index.ts",
    "predeploy": "pnpm generate-index && pnpm build",
    "prepare": "husky",
    "e2e": "pnpm playwright test",
    "e2e:prod": "PROD_RUN=true pnpm playwright test",
    "e2e:visual": "pnpm playwright test ./tests/visual-regression/ --project=chromium --workers=5",
    "unverified-song:upsert-fixture": "NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm tsx scripts/cicd/upsert-unverified-song-fixture.ts tests/fixtures/songs/shared-cloudflare-e2e.txt",
    "shared-song:upsert-fixture": "pnpm unverified-song:upsert-fixture",
    "peerjs": "pnpm node peer-js-server.js",
    "partykit:dev": "partykit dev",
    "youtube:duration": "pnpm tsx scripts/get-youtube-video-duration.ts",
    "songs:backfill-duration": "pnpm tsx scripts/backfill-song-durations.ts",
    "visual-diff:report": "pnpm tsx scripts/visual-regression/buildDiffReport.ts",
    "visual-diff:comment": "pnpm tsx scripts/visual-regression/renderComment.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:screenshots": "storybook build && playwright test -c playwright.storybook.config.ts",
    "knip": "knip --exclude exports,types,nsExports,nsTypes,enumMembers,duplicates,unresolved --no-config-hints",
    "type-check": "tsc --noEmit",
    "format": "oxfmt",
    "format-check": "oxfmt --config .oxfmtrc.ci.js src/**/*.{ts,tsx} --check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
