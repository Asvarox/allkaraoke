UNVERIFIED_SONGS_ADMIN_TOKEN=local-unverified-songs-admin-token
ADMIN_PANEL_PASSWORD=12345
# Online mode. Both optional locally: without them the game runs online mode on the Durable Object
# relay instead of the SFU, and STUN needs no credentials at all.
REALTIME_APP_ID=your-cloudflare-realtime-app-id
REALTIME_APP_TOKEN=your-cloudflare-realtime-app-token

# TURN is opt-in and never needed to develop. Set either the Cloudflare Realtime TURN pair...
# REALTIME_TURN_KEY_ID=your-turn-key-id
# REALTIME_TURN_API_TOKEN=your-turn-api-token
# ...or a TURN server of your own:
# ONLINE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# ONLINE_TURN_USERNAME=user
# ONLINE_TURN_CREDENTIAL=secret
# Only to move STUN off Cloudflare's public servers:
# ONLINE_STUN_URLS=stun:stun.example.com:3478
