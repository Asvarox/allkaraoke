EXTEND_ESLINT=true
VITE_APP_SENTRY_DSN_URL=""
VITE_APP_POSTHOG_KEY=""

VITE_APP_BACKEND_HOST="backend.allkaraoke.party"
VITE_APP_WEBSOCKET_URL="wss://allkaraoke-posthog.fly.dev"
VITE_APP_POSTHOG_PROXY="https://${VITE_APP_BACKEND_HOST}/posthog"
VITE_APP_SONG_CONVERT_PROXY="https://${VITE_APP_BACKEND_HOST}/proxy"
VITE_APP_PARTYKIT_URL="wss://allkaraoke-partykit.asvarox.partykit.dev"
# Standalone PartyKit deployment for online mode (partykit.json in this repo), deployed to a custom
# domain. Branch builds override this with their own preview room server (see ci-improvement.yml).
# The PartyKit room server backing the original (non-P2P) online mode. Still the default — the
# OnlineP2P feature flag is what moves a room onto the SFU instead.
VITE_APP_ONLINE_PARTYKIT_URL="wss://online.allkaraoke.party"

# P2P online mode signaling. Empty means same-origin: the Worker serves the app itself in
# production, and the Cloudflare vite plugin runs it inside the dev server. Set it only to point a
# build at another deployment.
VITE_APP_SIGNALING_URL=""

# Changing the config name to mts causes this https://github.com/vitejs/vite/issues/13267
VITE_CJS_IGNORE_WARNING=true

# Local unverified songs admin endpoint defaults (used by fixture upsert scripts)
UNVERIFIED_SONGS_ADMIN_URL="http://localhost:3000"
UNVERIFIED_SONGS_ADMIN_TOKEN="local-unverified-songs-admin-token"
