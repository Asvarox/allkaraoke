  "ignoreDependencies": [
    "vite-tsconfig-paths",
    "@mui/system",
    "peerjs",
    "tailwindcss-motion",
    "html-minifier",
    "@cloudflare/workers-types",
    "wrangler",
    "eslint-plugin-no-only-tests",
    "eslint-plugin-storybook",
    "eslint-plugin-react-compiler",
    "eslint-plugin-react-refresh",
    "serve"
